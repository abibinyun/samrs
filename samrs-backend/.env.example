# Server Configuration
APP_PORT=8080
JWT_SECRET=secret-key

# Seeder defaults
SEED_TENANT_NAME=RS Pusat Utama
SEED_TENANT_SLUG=rs-pusat
SEED_TENANT_STATUS=active
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password123

# Rate limiting
LOGIN_RATE_LIMIT=2
LOGIN_RATE_BURST=5
LOGIN_RATE_WINDOW_MINUTES=5
API_RATE_LIMIT=10
API_RATE_BURST=20
API_RATE_WINDOW_MINUTES=5

# Metrics protection (optional) // secret token to access metrics endpoint
# Authorize by adding header "Metrics-Token: <token_value>" || no value for Development mode
METRICS_TOKEN=secret-metrics-token-2026

# Logging
# Set LOG_FILE to "-" to disable file logging.
LOG_FILE=./logs/samrs.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=7
LOG_COMPRESS=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=db_name
DB_SSLMODE=disable

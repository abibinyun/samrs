### -------------------------------------------------------------------------
### 9. ADMIN TENANTS
### -------------------------------------------------------------------------

### 9.1 Create Tenant (Super Admin Only)
# @name createTenant
POST {{baseUrl}}/api/v1/admin/tenants
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "RS Cabang Selatan",
  "slug": "rs-cabang-selatan",
  "address": "Jl. Kesehatan No. 12",
  "type": "hospital",
  "status": "active"
}

### Simpan ID tenant dari response create
@tenantId = {{createTenant.response.body.data.id}}

###

### 9.2 Get Tenants With Roles (Super Admin Only)
GET {{baseUrl}}/api/v1/admin/tenants?page=1&per_page=20&sort_by=created_at&sort_dir=desc
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 9.3 Get Tenant Detail (Super Admin Only)
# Ganti {tenantId} dengan ID tenant dari response create
GET {{baseUrl}}/api/v1/admin/tenants/{{tenantId}}?user_page=1&user_per_page=20&user_search=&role_page=1&role_per_page=20&role_search=
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 9.4 Update Tenant (Super Admin Only)
# Ganti {tenantId} dengan ID tenant yang ingin diubah
PATCH {{baseUrl}}/api/v1/admin/tenants/{{tenantId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "RS Cabang Selatan Updated",
  "slug": "rs-cabang-selatan-updated",
  "address": "Jl. Kesehatan No. 15",
  "type": "hospital"
}

###

### 9.5 Update Tenant Status (Super Admin Only)
# Status: active | suspended
PATCH {{baseUrl}}/api/v1/admin/tenants/{{tenantId}}/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "suspended"
}


### -------------------------------------------------------------------------
### 10. DOCUMENT MANAGEMENT (GLOBAL)
### -------------------------------------------------------------------------

### 10.1 Create Document (Multi-file)
# @name createDocument
POST {{baseUrl}}/api/v1/documents
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=doc-boundary

--doc-boundary
Content-Disposition: form-data; name="title"

SOP Pemeliharaan Ventilator
--doc-boundary
Content-Disposition: form-data; name="doc_type"

sop
--doc-boundary
Content-Disposition: form-data; name="description"

Dokumen SOP dan lampiran pendukung
--doc-boundary
Content-Disposition: form-data; name="files"; filename="sop.pdf"
Content-Type: application/pdf

< ./fixtures/sop.pdf
--doc-boundary
Content-Disposition: form-data; name="files"; filename="lampiran.pdf"
Content-Type: application/pdf

< ./fixtures/lampiran.pdf
--doc-boundary--

### Simpan ID dokumen dari response
@documentId = {{createDocument.response.body.data.id}}

### 10.2 List Documents
GET {{baseUrl}}/api/v1/documents?search=SOP&doc_type=sop
Authorization: Bearer {{authToken}}

### 10.3 Get Document By ID
GET {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{authToken}}

### 10.4 Update Document Metadata
PATCH {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "SOP Pemeliharaan Ventilator (Revisi)",
  "doc_type": "sop",
  "description": "Revisi update SOP 2026"
}

### 10.5 Add Files to Document
POST {{baseUrl}}/api/v1/documents/{{documentId}}/files
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=doc-files

--doc-files
Content-Disposition: form-data; name="files"; filename="revisi.pdf"
Content-Type: application/pdf

< ./fixtures/revisi.pdf
--doc-files--

### 10.6 List Document Files
# @name listDocumentFiles
GET {{baseUrl}}/api/v1/documents/{{documentId}}/files
Authorization: Bearer {{authToken}}

### Simpan ID file dari response list
@fileId = {{listDocumentFiles.response.body.data.0.id}}

### 10.7 Download Document File
# Ganti {fileId} dengan ID file dari response list
GET {{baseUrl}}/api/v1/document-files/{{fileId}}/download
Authorization: Bearer {{authToken}}

### 10.8 Delete Document File
DELETE {{baseUrl}}/api/v1/document-files/{{fileId}}
Authorization: Bearer {{authToken}}

### 10.9 Delete Document
DELETE {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{authToken}}


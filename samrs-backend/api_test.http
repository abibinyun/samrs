### -------------------------------------------------------------------------
### 6. RBAC MANAGEMENT
### -------------------------------------------------------------------------

### 6.1 Get Permissions
GET {{baseUrl}}/api/v1/permissions
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 6.2 Create Role
# @name createRole
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Operator 1"
}

### Simpan Role ID
@roleId = {{createRole.response.body.data.id}}

###

### 6.2b Get Role By ID
GET {{baseUrl}}/api/v1/roles/{{roleId}}
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 6.2c Set Tenant Admin Flag (Super Admin Only)
PATCH {{baseUrl}}/api/v1/roles/{{roleId}}/tenant-admin
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "is_tenant_admin": true
}

###

### 6.3 Assign Permissions to Role
POST {{baseUrl}}/api/v1/roles/{{roleId}}/permissions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "permission_ids": [1,2,3]
}

###

### 6.4 Get Permissions By Role
GET {{baseUrl}}/api/v1/roles/{{roleId}}/permissions
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 6.5 Create User
# @name createUser
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "username": "operator1",
    "password": "password123",
    "role_id": 3,
    "is_active": true
}

### Simpan User ID
@userId = {{createUser.response.body.data.id}}

###

### 6.6 List Users (Paged)
GET {{baseUrl}}/api/v1/users?page=1&per_page=20&search=
Authorization: Bearer {{authToken}}
Accept: application/json

###

### 6.7 Update User Profile
PATCH {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "username": "operator1-updated"
}

###

### 6.8 Update User Role
PATCH {{baseUrl}}/api/v1/users/{{userId}}/role
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "role_id": {{roleId}}
}

###

### 6.9 Update User Status
PATCH {{baseUrl}}/api/v1/users/{{userId}}/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "is_active": true
}

###

### 6.10 Reset User Password
PATCH {{baseUrl}}/api/v1/users/{{userId}}/password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "password": "password456"
}

###

### 6.11 Delete User
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{authToken}}


